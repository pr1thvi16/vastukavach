# Set this when your public site uses a custom domain. Otherwise Vercel's
# production domain (or https://vastukavach.vercel.app) is used automatically.
NEXT_PUBLIC_SITE_URL=

# Optional verified contact channels. Use international digits for WhatsApp, no +.
# WhatsApp links open a prefilled message; the business number must have its own WhatsApp bot/automation configured to reply.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567

# Configure either a trusted HTTPS webhook or Resend email delivery.
BOOKING_WEBHOOK_URL=

# Optional Resend delivery. Verify the sender domain in Resend first.
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
BOOKING_FROM_EMAIL=
