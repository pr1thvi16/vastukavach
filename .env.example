NEXT_PUBLIC_CONTACT_EMAIL=info@kavachconsultancy.com
NEXT_PUBLIC_WHATSAPP_NUMBER=971564527299

# Supabase publishable configuration. These values are designed for public apps.
# Booking submissions are protected by the insert-only RLS policy in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://qidfdtanwbvlporikhjj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5hsYAgReOSB7SnK_-b5X0A_krtkqOp6

