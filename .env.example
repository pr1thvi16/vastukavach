# Public canonical origin after deployment; used by sitemap and robots metadata.
NEXT_PUBLIC_SITE_URL=

# Optional verified contact channels. Use international digits for WhatsApp, no +.
# WhatsApp links open a prefilled message; the business number must have its own WhatsApp bot/automation configured to reply.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Required for booking submissions to be delivered. Receives a JSON POST.
BOOKING_WEBHOOK_URL=
